{
  "name": "vinay-chunchu-portfolio",
  "version": "2.0.0",
  "description": "Personal portfolio website for Vinay Chunchu - Software Engineer",
  "main": "index.html",
  "scripts": {
    "start": "live-server --port=3000 --open=/",
    "dev": "live-server --port=3000 --open=/ --watch=assets/",
    "preview": "python -m http.server 8000",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "validate-html": "html-validate index.html",
    "lighthouse": "lighthouse http://localhost:8000 --output=html --output-path=./lighthouse-report.html",
    "test": "echo \"Static site - no tests needed\" && exit 0"
  },
  "keywords": [
    "portfolio",
    "personal-website",
    "software-engineer",
    "web-development",
    "responsive-design",
    "javascript",
    "html5",
    "css3"
  ],
  "author": {
    "name": "Vinay Chunchu",
    "email": "vinaychunchu@hotmail.com",
    "url": "https://github.com/VinayChunchu"
  },
  "license": "MIT",
  "homepage": "https://vinaychunchu.github.io/portfolio",
  "repository": {
    "type": "git",
    "url": "https://github.com/VinayChunchu/portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/VinayChunchu/portfolio/issues"
  },
  "devDependencies": {
    "html-validate": "^8.7.4",
    "lighthouse": "^11.4.0",
    "live-server": "^1.2.2",
    "prettier": "^3.1.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}